# MiniMax API key (Bearer token for `Authorization: Bearer ...`).
# Get one at https://platform.minimax.io/user-center/basic-information/interface-key
# This file lives at C:\source\pathfinder-notes\.env on disk (git-ignored).

MINIMAX_API_KEY=eyJ...replace-me...

# Optional overrides — every one of these has a default in the code, set them
# only when you want to override the default.
#
# MINIMAX_API_URL=https://api.minimax.io/v1/speech_to_text
# ASR_MODEL=asr-1.0
# ASR_LANGUAGE=en
# ASR_RESPONSE_FORMAT=verbose_json           # json | verbose_json (verbose_json tracks speakers per segment)
# CHUNK_SECONDS=30
# TRANSCRIPT_DIR=transcripts
#
# PF2e session recap (opt-in; costs tokens). Use --summarize on the CLI instead.
# ENABLE_SESSION_SUMMARY=true                # default false
# SUMMARY_MODEL=MiniMax-M3                   # language model for the recap
# SUMMARY_API_URL=https://api.minimax.io/anthropic/v1/messages
# SUMMARY_MAX_TOKENS=4096
# SUMMARY_TEMPLATE_PATH=                     # leave blank to use bundled template
