<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pathfinder.Notes</RootNamespace>
    <AssemblyName>pathfinder-notes</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- WASAPI mic + output-loopback capture -->
    <PackageReference Include="NAudio" Version="2.2.0" />
    <PackageReference Include="PortAudioSharp2" Version="1.0.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the PF2e template alongside the binary -->
    <None Update="pf2e-session-template.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
